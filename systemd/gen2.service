[Unit]
Description=CMP 170HX bounded PCIe Gen2 second driver pass
DefaultDependencies=no
After=sysinit.target
Before=basic.target multi-user.target graphical.target
ConditionPathExists=/usr/local/sbin/gen2-second-pass

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gen2-second-pass auto
TimeoutStartSec=180
RemainAfterExit=no

[Install]
WantedBy=sysinit.target
