+/*
+ * CMP90_STOCKFLOW_REJOIN16: apply the PCIe Gen2 speed-path configuration and
+ * retrain the link, from the driver, right after nv_start_device() completes.
+ * At this point GSP-RM has finished its init-time link setup (it reverts
+ * userspace writes to PRIV_MISC_1/LINK_CONFIG_0 during init), the PCIe
+ * privilege masks are open, and no user traffic is running yet. Userspace
+ * pokes of LINK_CONFIG_0 outside this window intermittently wedge the XVE
+ * block; in-kernel at this point mirrors the GA100 cmpunlocker's approach.
+ */
+static void
+nv_cmp90hx_gen2_config(nv_state_t *nv)
+{
+    nv_linux_state_t *nvl = NV_GET_NVL_FROM_NV_STATE(nv);
+    struct pci_dev *gpu = nvl->pci_dev;
+    struct pci_dev *upstream;
+    void __iomem *bar0;
+    u16 gpu_ctl2, upstream_ctl2, upstream_ctl, link_status = 0;
+    u32 val;
+    int ret, attempt;
+
+    if ((gpu == NULL) || (gpu->device != 0x220d) ||
+        (gpu->subsystem_vendor != 0x10de) || (gpu->subsystem_device != 0x1555))
+        return;
+
+    upstream = pci_upstream_bridge(gpu);
+    if (upstream == NULL)
+    {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP90 Gen2: no upstream PCIe bridge; skipping\n");
+        return;
+    }
+
+    /* map the whole 16MB BAR0: the FEAT_OVR_ECC_PLM gate lives at 0x823800 */
+    bar0 = ioremap(pci_resource_start(gpu, 0), 0x1000000);
+    if (bar0 == NULL)
+    {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP90 Gen2: cannot map BAR0; skipping\n");
+        return;
+    }
+
+    /* Only when ALL the PCIe privilege masks are open (rejoin16 crafted-
+     * Booter writes; FEAT_OVR_ECC_PLM is the last one opened by the apply
+     * script). Otherwise the speed path is locked and poking it is unsafe. */
+    if (readl(bar0 + 0x823800) != 0xffffffffU)
+    {
+        iounmap(bar0);
+        return;
+    }
+
+    val = readl(bar0 + 0x8841c);   /* PRIV_MISC_1: GEN2_EN set, VAL clear */
+    writel((val | (1U << 11) | (1U << 13)) & ~((1U << 12) | (1U << 14)),
+           bar0 + 0x8841c);
+    writel(readl(bar0 + 0x8c2c0) & ~(1U << 2), bar0 + 0x8c2c0); /* CYA_0 */
+    writel(0x00000000U, bar0 + 0x8e120);   /* XP3G_VAL0 */
+    writel(0x00000001U, bar0 + 0x8e110);   /* XP3G_OVR0 */
+    writel(0x00200000U, bar0 + 0x8e12c);   /* XP3G_VAL3 */
+    writel(0x00000004U, bar0 + 0x8e11c);   /* XP3G_OVR3 */
+    val = readl(bar0 + 0x8c040);           /* LINK_CONFIG_0 MAX_RATE=2 */
+    writel((val & ~0x000c0000U) | (2U << 18), bar0 + 0x8c040);
+    writel(0x00000006U, bar0 + 0x8872c);   /* XVE_LTSSM override */
+    (void)readl(bar0 + 0x8872c);
+    iounmap(bar0);
+    msleep(50);
+
+    ret = pcie_capability_read_word(gpu, PCI_EXP_LNKCTL2, &gpu_ctl2);
+    if (ret)
+        goto capability_error;
+    ret = pcie_capability_read_word(upstream, PCI_EXP_LNKCTL2, &upstream_ctl2);
+    if (ret)
+        goto capability_error;
+    gpu_ctl2 = (gpu_ctl2 & ~PCI_EXP_LNKCTL2_TLS) | PCI_EXP_LNKCTL2_TLS_5_0GT;
+    upstream_ctl2 = (upstream_ctl2 & ~PCI_EXP_LNKCTL2_TLS) | PCI_EXP_LNKCTL2_TLS_5_0GT;
+    ret = pcie_capability_write_word(gpu, PCI_EXP_LNKCTL2, gpu_ctl2);
+    if (ret)
+        goto capability_error;
+    ret = pcie_capability_write_word(upstream, PCI_EXP_LNKCTL2, upstream_ctl2);
+    if (ret)
+        goto capability_error;
+    ret = pcie_capability_read_word(upstream, PCI_EXP_LNKCTL, &upstream_ctl);
+    if (ret)
+        goto capability_error;
+    ret = pcie_capability_write_word(upstream, PCI_EXP_LNKCTL,
+                                     upstream_ctl | PCI_EXP_LNKCTL_RL);
+    if (ret)
+        goto capability_error;
+
+    for (attempt = 0; attempt < 20; attempt++)
+    {
+        msleep(100);
+        ret = pcie_capability_read_word(gpu, PCI_EXP_LNKSTA, &link_status);
+        if (!ret &&
+            ((link_status & PCI_EXP_LNKSTA_CLS) >= PCI_EXP_LNKSTA_CLS_5_0GB))
+        {
+            NV_DEV_PRINTF(NV_DBG_INFO, nv, "CMP90 Gen2: PCIe link trained to Gen%u\n",
+                          link_status & PCI_EXP_LNKSTA_CLS);
+            return;
+        }
+    }
+
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP90 Gen2: retrain completed without Gen2 link (status=0x%04x)\n",
+                  link_status);
+    return;
+capability_error:
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP90 Gen2: PCIe capability access failed (%d); skipping\n", ret);
+}
+
 static DEFINE_MUTEX(cmp90_rejoin15_start_lock);
 
 #include <linux/cdev.h>
