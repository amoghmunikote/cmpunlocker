+/*
+ * CMP90_STOCKFLOW_REJOIN16: refill the write value (0xf948) and write
+ * target BAR0 address (0xf960) slots of the active V67 payload so that one
+ * more crafted Booter execution performs one more privileged BAR0 write.
+ * Must be called before kgspCmp90RestoreStockSignatureForBooter, while the
+ * V67 signature memdesc is still the active one.
+ */
+NV_STATUS
+kgspCmp90V67RefillWrite
+(
+    OBJGPU *pGpu,
+    KernelGsp *pKernelGsp,
+    NvU32 writeAddr,
+    NvU32 writeValue
+)
+{
+    NvU8 *pSignatureVa;
+
+    if (!_kgspCmp90IsExactTarget(pGpu))
+        return NV_ERR_INVALID_STATE;
+
+    if (pKernelGsp->pSignatureMemdesc == NULL)
+        return NV_ERR_INVALID_STATE;
+
+    if (memdescGetSize(pKernelGsp->pSignatureMemdesc) !=
+            CMP90_PC_EXACT_SIGNATURE_SIZE)
+        return NV_ERR_INVALID_STATE;
+
+    pSignatureVa = memdescMapInternal(pGpu, pKernelGsp->pSignatureMemdesc,
+                                      TRANSFER_FLAGS_NONE);
+    if (pSignatureVa == NULL)
+        return NV_ERR_INSUFFICIENT_RESOURCES;
+
+    _kgspCmp90PutU32(pSignatureVa, 0xf948U, writeValue);
+    _kgspCmp90PutU32(pSignatureVa, 0xf960U, writeAddr);
+
+    memdescUnmapInternal(pGpu, pKernelGsp->pSignatureMemdesc, 0);
+    memdescFlushCpuCaches(pGpu, pKernelGsp->pSignatureMemdesc);
+
+    return NV_OK;
+}
+
