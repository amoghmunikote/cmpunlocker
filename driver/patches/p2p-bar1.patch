     {
         pKernelBus->bUsePhysicalBar2InitPagetable = NV_TRUE;
+    }
+
+    // CMP uses the existing BAR1 transport HALs to bypass its mailbox path.
+    if ((pGpu->idInfo.PCIDeviceID >> 16) == 0x20C2 ||
+        (pGpu->idInfo.PCIDeviceID >> 16) == 0x2082)
+    {
+        pKernelBus->__kbusGetBar1P2PDmaInfo__ = &kbusGetBar1P2PDmaInfo_GH100;
+        pKernelBus->__kbusCreateP2PMappingForBar1P2P__ = &kbusCreateP2PMappingForBar1P2P_GH100;
+        pKernelBus->__kbusRemoveP2PMappingForBar1P2P__ = &kbusRemoveP2PMappingForBar1P2P_GH100;
+        pKernelBus->__kbusHasPcieBar1P2PMapping__ = &kbusHasPcieBar1P2PMapping_GH100;
+        pKernelBus->__kbusIsPcieBar1P2PMappingSupported__ = &kbusIsPcieBar1P2PMappingSupported_GH100;
     }
 
