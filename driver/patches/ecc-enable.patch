+static void
+_kgspCmpHbmEcc10gbArm(OBJGPU *pGpu, KernelGsp *pKernelGsp)
+{
+    static const struct { NvU32 addr; NvU32 val; NvU32 isOr; } eccArm[] = {
+        { 0x001fa7ccU, 0xffffffffU, 0U },
+        { 0x001fa7c8U, 0xffffffffU, 0U },
+        { 0x001fa7c0U, 0xffffffffU, 0U },
+        { 0x001fa7d0U, 0xffffffffU, 0U },
+        { 0x00823800U, 0xffffffffU, 0U },
+        { 0x009a0470U, 0x00000041U, 1U },
+        { 0x009a1004U, 0x00000200U, 1U },
+        { 0x009a033cU, 0x00000003U, 1U },
+        { 0x009a0084U, 0x00000001U, 1U },
+        { 0x0017e318U, 0x00000001U, 1U },
+        { 0x0017e21cU, 0x00000001U, 1U },
+        { 0x00823810U, 0x003ffebfU, 0U },
+        { 0x0082382cU, 0x0000000fU, 0U },
+        { 0x0082380cU, 0x00999999U, 0U },
+    };
+    NvU32 i, v, enable = 0;
+
+    if (osReadRegistryDword(pGpu, "RmCmpHbmEcc", &enable) != NV_OK || enable == 0)
+        return;
+
+    for (i = 0; i < NV_ARRAY_ELEMENTS(eccArm); i++)
+    {
+        GPU_REG_WR32(pGpu, 0x001fa824U, 0xffffffffU);
+        GPU_REG_WR32(pGpu, 0x001fa828U, 0x00000000U);
+        v = eccArm[i].isOr ? (GPU_REG_RD32(pGpu, eccArm[i].addr) | eccArm[i].val) : eccArm[i].val;
+        (void) kgspSec2PostblTimingRefillPayload(pGpu, pKernelGsp, eccArm[i].addr, v);
+        (void) kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp,
+            memdescGetPhysAddr(SEC2_POSTBL_TIMING_WPR_META_DESC(pKernelGsp), AT_GPU, 0));
+    }
+    GPU_REG_WR32(pGpu, 0x001fa81cU, 0xffffffffU); GPU_REG_WR32(pGpu, 0x001fa820U, 0x00000000U);
+    GPU_REG_WR32(pGpu, 0x001fa824U, 0xffffffffU); GPU_REG_WR32(pGpu, 0x001fa828U, 0x00000000U);
+    GPU_REG_WR32(pGpu, 0x001fa804U, 0xffffffffU); GPU_REG_WR32(pGpu, 0x001fa808U, 0x00000000U);
+    GPU_REG_WR32(pGpu, 0x001fa82cU, 0xffffffffU); GPU_REG_WR32(pGpu, 0x001fa830U, 0x00000000U);
+    GPU_REG_WR32(pGpu, 0x001fa80cU, GPU_REG_RD32(pGpu, 0x001fa80cU) & ~0x10U);
+
+    if (GPU_REG_RD32(pGpu, 0x00823814U) & 0x00010000U)
+        NV_PRINTF(LEVEL_ERROR,
+            "cmpunlocker: HBM ECC armed (RmCmpHbmEcc=1). If this GPU now fails with Xid 140, "
+            "remove RmCmpHbmEcc=1 for it and reboot.\n");
+    else
+        NV_PRINTF(LEVEL_ERROR,
+            "cmpunlocker: RmCmpHbmEcc=1 set but ECC_DRAM did not latch (FEAT_READOUT=0x%08x)\n",
+            GPU_REG_RD32(pGpu, 0x00823814U));
+}
