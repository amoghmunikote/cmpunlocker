--- a/src/nvidia/src/kernel/gpu/bus/arch/maxwell/kern_bus_gm200.c
+++ b/src/nvidia/src/kernel/gpu/bus/arch/maxwell/kern_bus_gm200.c
@@ -50,6 +50,117 @@
  * @return void
  */
 void
+//
+// CMPUNLOCK: PRI decode trap around the P2P mailbox setup RPC.
+//
+// The setup RPC programs the P2P aperture registers at a PRI level the CMP
+// refuses. Trap 31 can be aimed at those writes to re-stamp them at a level
+// that is accepted. Whether that is possible depends on the trap's own
+// PRIV_LEVEL_MASK: 0xFFFFFFFF means level 0 may write the trap, anything else
+// means it cannot be armed from the kernel driver.
+//
+// Arming is best effort on purpose. If the trap is unavailable the mailbox
+// setup still runs, unmodified, exactly as the stock driver would run it. That
+// is better than refusing to set P2P up at all, and it is how we find out
+// whether a given part needs the trap in the first place.
+//
+#define CMP_TRAP31_MATCH_REG   0x0012247cU
+#define CMP_TRAP31_MASK_REG    0x001224fcU
+#define CMP_TRAP31_DATA1_REG   0x0012257cU
+#define CMP_TRAP31_DATA2_REG   0x001225fcU
+#define CMP_TRAP31_ACTION_REG  0x0012267cU
+#define CMP_TRAP31_CFG_REG     0x001226fcU
+#define CMP_TRAP31_PLM_REG     0x0012277cU
+
+#define CMP_TRAP31_P2P_MATCH   0x00139000U
+#define CMP_TRAP31_P2P_MASK    0xfc000fffU
+#define CMP_TRAP31_P2P_DATA1   0xc0000000U
+#define CMP_TRAP31_P2P_CFG     0x0001c010U
+#define CMP_TRAP31_SET_PRIV    0x00100000U
+
+typedef struct
+{
+    NvU32  match;
+    NvU32  mask;
+    NvU32  data1;
+    NvU32  data2;
+    NvU32  action;
+    NvU32  cfg;
+    NvBool valid;
+} CMP_P2P_TRAP;
+
+static NvBool
+_cmpIsCmpGpu(OBJGPU *pGpu)
+{
+    NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+
+    return (devId == 0x20C2) || (devId == 0x2082);
+}
+
+static void
+_cmpP2PTrapRestore(OBJGPU *pGpu, CMP_P2P_TRAP *pState)
+{
+    if ((pState == NULL) || !pState->valid)
+        return;
+
+    // Stop acting first, put the payload back, restore ACTION last.
+    GPU_REG_WR32(pGpu, CMP_TRAP31_ACTION_REG, 0);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_CFG_REG,    pState->cfg);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_DATA2_REG,  pState->data2);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_DATA1_REG,  pState->data1);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_MASK_REG,   pState->mask);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_MATCH_REG,  pState->match);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_ACTION_REG, pState->action);
+    pState->valid = NV_FALSE;
+}
+
+static void
+_cmpP2PTrapArm(OBJGPU *pGpu, CMP_P2P_TRAP *pState)
+{
+    NvU32 plm;
+
+    pState->valid = NV_FALSE;
+
+    if (!_cmpIsCmpGpu(pGpu))
+        return;
+
+    plm = GPU_REG_RD32(pGpu, CMP_TRAP31_PLM_REG);
+    if (plm != 0xFFFFFFFFU)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "CMPUNLOCK: P2P trap31 not writable (PLM 0x%08x); continuing "
+                  "without it\n", plm);
+        return;
+    }
+
+    pState->match  = GPU_REG_RD32(pGpu, CMP_TRAP31_MATCH_REG);
+    pState->mask   = GPU_REG_RD32(pGpu, CMP_TRAP31_MASK_REG);
+    pState->data1  = GPU_REG_RD32(pGpu, CMP_TRAP31_DATA1_REG);
+    pState->data2  = GPU_REG_RD32(pGpu, CMP_TRAP31_DATA2_REG);
+    pState->action = GPU_REG_RD32(pGpu, CMP_TRAP31_ACTION_REG);
+    pState->cfg    = GPU_REG_RD32(pGpu, CMP_TRAP31_CFG_REG);
+    pState->valid  = NV_TRUE;
+
+    GPU_REG_WR32(pGpu, CMP_TRAP31_ACTION_REG, 0);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_DATA1_REG,  CMP_TRAP31_P2P_DATA1);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_DATA2_REG,  0);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_CFG_REG,    CMP_TRAP31_P2P_CFG);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_MATCH_REG,  CMP_TRAP31_P2P_MATCH);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_MASK_REG,   CMP_TRAP31_P2P_MASK);
+    GPU_REG_WR32(pGpu, CMP_TRAP31_ACTION_REG, CMP_TRAP31_SET_PRIV);
+
+    if ((GPU_REG_RD32(pGpu, CMP_TRAP31_MATCH_REG)  != CMP_TRAP31_P2P_MATCH) ||
+        (GPU_REG_RD32(pGpu, CMP_TRAP31_MASK_REG)   != CMP_TRAP31_P2P_MASK)  ||
+        (GPU_REG_RD32(pGpu, CMP_TRAP31_DATA1_REG)  != CMP_TRAP31_P2P_DATA1) ||
+        (GPU_REG_RD32(pGpu, CMP_TRAP31_CFG_REG)    != CMP_TRAP31_P2P_CFG)   ||
+        (GPU_REG_RD32(pGpu, CMP_TRAP31_ACTION_REG) != CMP_TRAP31_SET_PRIV))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "CMPUNLOCK: P2P trap31 did not take; continuing without it\n");
+        _cmpP2PTrapRestore(pGpu, pState);
+    }
+}
